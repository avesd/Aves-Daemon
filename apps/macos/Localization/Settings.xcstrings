    "analytics.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send app launches, overlay displays, and detail expansions to PostHog."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向 PostHog 发送应用启动、浮层显示和详情展开事件。"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar a PostHog eventos de inicio de la app, visualización del panel y apertura de detalles."
          }
        }
      }
    },
    "analytics.disabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DO_NOT_TRACK=1 disables usage statistics for this launch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次启动已通过 DO_NOT_TRACK=1 停用使用统计。"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "DO_NOT_TRACK=1 desactiva las estadísticas de uso en esta sesión."
          }
        }
      }
    },
