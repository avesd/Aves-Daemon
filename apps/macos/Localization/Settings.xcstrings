{
  "sourceLanguage": "en",
  "strings": {
    "about.attribution": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rain summaries use [MET Norway](https://www.met.no/en) forecasts under [CC BY 4.0](https://creativecommons.org/licenses/by/4.0/)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "降雨摘要使用 [MET Norway](https://www.met.no/en) 提供的预报，依据 [CC BY 4.0](https://creativecommons.org/licenses/by/4.0/) 许可。"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resúmenes de lluvia usan los pronósticos de [MET Norway](https://www.met.no/en) con licencia [CC BY 4.0](https://creativecommons.org/licenses/by/4.0/)."
          }
        }
      }
    },
    "about.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A menu bar app that previews passing aircraft at the edge of your screen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这款菜单栏应用会在屏幕边缘显示飞过的航班。"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Una app de la barra de menús que muestra en el borde de la pantalla los aviones que pasan."
          }
        }
      }
    },
    "about.done": {
      "extractionState": "manual",
